{
  "name": "bytestash-server",
  "version": "1.0.0",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "seed:test": "cross-env NODE_ENV=test node scripts/seed-test-db.js",
    "clear:test": "cross-env NODE_ENV=test node scripts/clear-test-db.js",
    "start:test": "npm run seed:test && cross-env ALLOW_NEW_ACCOUNTS=true JWT_SECRET=specmatic-test-secret node src/app.js",
    "test": "jest",
    "specmatic:validate": "npx specmatic examples validate --spec-file docs/swagger.yaml",
    "test:contract": "cross-env SPECMATIC_GENERATIVE_TESTS=true npx specmatic test --testBaseURL=http://localhost:5000",
    "ci:contract": "npm run specmatic:validate && npm run test:contract"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "bad-words": "^4.0.0",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.5.0",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openid-client": "^6.1.3",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "specmatic": "^2.51.0"
  }
}
